#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>

#define SERVICE_UUID        "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define CHARACTERISTIC_UUID "beb5483e-36e1-4688-b7f5-ea07361b26a8"

BLECharacteristic *pCharacteristic;
bool czyPolaczony = false;

class MojeCallbacki: public BLEServerCallbacks {
    void onConnect(BLEServer* pServer) override {
      czyPolaczony = true;
      Serial.println("Telefon polaczony!");
      
      // Energooszczędny interwał połączenia (1.25s - 2.0s)
      pServer->updateConnParams(pServer->getConnId(), 1000, 1600, 4, 600);
    }
    void onDisconnect(BLEServer* pServer) override {
      czyPolaczony = false;
      Serial.println("Telefon rozlaczony");
      pServer->getAdvertising()->start();
    }
};

#define LED_PIN      15
#define REED_PIN     4   // Pin kontaktronu (GPIO 4)
#define BATTERY_PIN  0   // Pin pomiaru baterii (GPIO 0)

int licznikObrotow = 0;
int ostatnioWyslaneObroty = -1; // Zapamiętuje stan z ostatniej wysyłki

int laststate = HIGH;
unsigned long ostatniObrot = 0;
const unsigned long DEBOUNCE_MS = 50;

unsigned long ostatniaWysylka = 0;
const unsigned long INTERWAL_WYSYLKI_MS = 30000; // Co 30 sekund

const int LICZBA_PROBEK_ADC = 16;

float odczytajNapiecieBaterii() {
  long sumaMiliVolt = 0;
  for (int i = 0; i < LICZBA_PROBEK_ADC; i++) {
    sumaMiliVolt += analogReadMilliVolts(BATTERY_PIN);
    delayMicroseconds(200);
  }
  float avgMiliVolt = sumaMiliVolt / (float)LICZBA_PROBEK_ADC;
  return (avgMiliVolt * 2.0) / 1000.0;
}

int przeliczNaProcenty(float napiecie) {
  int procent = map(napiecie * 100, 330, 420, 0, 100);
  return constrain(procent, 0, 100);
}

void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(LED_PIN, OUTPUT);
  pinMode(REED_PIN, INPUT_PULLUP);

  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);

  Serial.println("Start - Wysylka danych TYLKO po wykryciu ruchu");

  // Inicjalizacja BLE
  BLEDevice::init("Kolo-Chomika");
  BLEServer *pServer = BLEDevice::createServer();
  pServer->setCallbacks(new MojeCallbacki());

  BLEService *pService = pServer->createService(SERVICE_UUID);

  pCharacteristic = pService->createCharacteristic(
                      CHARACTERISTIC_UUID,
                      BLECharacteristic::PROPERTY_READ |
                      BLECharacteristic::PROPERTY_NOTIFY
                    );
  pCharacteristic->addDescriptor(new BLE2902());

  pService->start();
  pServer->getAdvertising()->start();
  Serial.println("BLE gotowe, czekam na polaczenie...");

  ostatniaWysylka = millis();
}

void loop() {
  // 1. Zliczanie obrotów w czasie rzeczywistym
  int state = digitalRead(REED_PIN);
  digitalWrite(LED_PIN, state == LOW ? HIGH : LOW);

  if (state != laststate) {
    unsigned long teraz = millis();
    if (teraz - ostatniObrot > DEBOUNCE_MS) {
      if (state == HIGH) {
        licznikObrotow++;
        Serial.print("Obrocono kolo. Suma: ");
        Serial.println(licznikObrotow);
      }
      ostatniObrot = teraz;
      laststate = state;
    }
  }

  // 2. Wysyłanie paczki danych co 30 sekund – TYLKO jeśli był nowy ruch
  unsigned long teraz = millis();
  if (teraz - ostatniaWysylka >= INTERWAL_WYSYLKI_MS) {
    ostatniaWysylka = teraz;

    // Warunek sprawdzający, czy przybyły nowe obroty od ostatniej wysyłki
    if (licznikObrotow != ostatnioWyslaneObroty) {
      ostatnioWyslaneObroty = licznikObrotow; // Zapamiętujemy wysłany stan

      float napiecie = odczytajNapiecieBaterii();
      int poziomProcent = przeliczNaProcenty(napiecie);

      // Czytelny format tekstu bez skomplikowanych cudzysłowów JSON
      String dane = "Obroty: " + String(licznikObrotow) + 
                    " | Bat: " + String(poziomProcent) + 
                    "% (" + String(napiecie, 2) + "V)";

      Serial.print("--- Wysylanie nowych danych: ");
      Serial.println(dane);

      if (czyPolaczony) {
        pCharacteristic->setValue(dane.c_str());
        pCharacteristic->notify();
      }
    }
  }
}
